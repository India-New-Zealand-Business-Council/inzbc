# INZBC platform — environment variables (NAMES ONLY, no real values).
# Copy to .env for local dev (.env is gitignored). In CI/production these live as GitHub
# Actions secrets, never in a file. NEVER paste real keys into this file, a commit, a PR, an
# issue, or a chat. If a key is ever exposed, rotate it at the provider before reuse.

# --- Model gateway (services/api/model_gateway.py) ---
OPENAI_API_KEY=            # platform.openai.com — the account the daily brief already uses
SIP_MODEL_NAME=            # optional; defaults to gpt-4.1-mini
PERPLEXITY_API_KEY=        # optional second provider (gateway v0.2)

# --- Collection engine (shared with daily-india-nz-news-agent) ---
NEWSAPI_KEY=               # newsapi.org
EMAIL_FROM=                # sending Gmail address for the brief
EMAIL_PASSWORD=            # Google App Password (not the account password)
EMAIL_TO=                  # authorised recipient (launch-config: Sunil only)
GOOGLE_SCRIPT_URL=         # Apps Script web-app /exec endpoint for sheet writes
