# Secrets and environment — never commit
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
*.p12
*_secret*
*secret*.json
credentials.json

# Node / npm
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Test / coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/
.pytest_cache/

# Build output
dist/
build/
*.egg-info/
.vite/
storybook-static/
.next/
out/

# Logs and OS cruft
*.log
.DS_Store
Thumbs.db

# Internal / personal docs — kept local, not for the shared repo
docs/services-agreement-draft.md
docs/sunil-requests.md
docs/inzbc-talking-points.md
docs/sip/sunil-update.md

# The .local suffix now means what it says. It previously did not: AUDIT.local.md and
# DESIGN.local.md both described themselves as gitignored while being tracked and readable by
# everyone with repo access. Anything genuinely shared gets a normal name instead.
*.local.md

# Render/preview artifacts
*.png
.playwright-mcp/

# Board snapshots are working state, not a record. A stale one committed here would be
# restored over good data by someone trusting it. Regenerate with scripts/board.py snapshot.
board-snapshot.json
board-before-*.json

# Local editor and assistant configuration. Kept out of the repository because it is
# per-machine tooling setup, not project state: paths, hooks and skill definitions differ
# between contributors and a shared copy would fight them. Contributor rules that DO
# belong to the project are in PROJECT-RULES.md and CONTRIBUTING.md, which are tracked.
.claude/
.agent-local/
.remember/

# Scratch space for one-off analysis and rendering. Working files, not project state.
.tmp/
.gstack/

# Generated deliverables and the working directories that build them. These are outputs, not
# project state: the decks are rebuilt from `ppt_group_report_work/build_group_final.mjs` on
# demand, and the layout/inspect dumps beside them are that script's intermediate artefacts.
#
# 119 of these were committed by accident in #357 and untracked immediately after. Listing them
# here rather than relying on care is the point: a blanket `git add -A` during a conflict
# resolution is exactly the moment nobody is checking, which is how they got in.
#
# The evidence portfolios are individual work product. They belong to the person who wrote them,
# not in a shared organisation repository where every contributor can read them.
INZBC_Group_Final_Report_*.pptx
INZBC_Group_Final_Report_*.pptx.inspect.ndjson
ppt_group_report_work/
team_report_work/
bhanu_evidence_work/
