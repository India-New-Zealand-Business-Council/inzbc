# ==============================================================================
# FILE 1 OF 5: ENVIRONMENT & SECRETS CONFIGURATION (from .env.example + audit_seal.py)
# HOW IT WORKS:
#   - Local dev loads secrets from a gitignored `.env` file.
#   - CI & Production inject these via GitHub Actions / host secrets (never committed).
#   - Gitleaks CI job blocks any accidental key commit automatically.
# ==============================================================================

# --- 1. MODEL GATEWAY (services/api/model_gateway.py) ---
# All AI calls route through our server-side Model Gateway (never directly from frontend).
# The Gateway redacts PII before sending prompts and logs token usage to PostgreSQL.
OPENAI_API_KEY=                 # Primary LLM API key used by Model Gateway for brief drafting & assistant
SIP_MODEL_NAME=                 # Optional model override (defaults to gpt-4.1-mini if unset)
PERPLEXITY_API_KEY=             # Optional secondary provider supported by Model Gateway v0.2
COMMS_EXTERNAL_MODEL_ENABLED=   # FAIL-CLOSED feature flag: Comms drafting stays OFF unless literally "true"

# --- 2. CRYPTOGRAPHIC AUDIT SIGNING (apps/sip/core/audit_seal.py — ADR-0010) ---
# Server-held signing key: the AI agent loop NEVER has access to this variable.
SIP_DECISION_SIGNING_KEY=       # >= 32-byte secret used for HMAC-SHA256 human decision signatures + hash-chain seal
SIP_REQUIRE_SIGNED_DECISIONS=   # Set to "true" to reject any unsigned gated transition (even legacy rows)

# --- 3. DATABASE & AUTH ---
DATABASE_URL=                   # PostgreSQL 16.2 connection string (30 tables, 16 append-only triggers, pgvector)

# --- 4. NEWS COLLECTION & DELIVERY (shared with daily-india-nz-news-agent) ---
NEWSAPI_KEY=                    # NewsAPI key for ingesting live India–NZ bilateral news candidates
EMAIL_FROM=                     # Authorised sender Gmail address for manual brief distribution
EMAIL_PASSWORD=                 # Google App Password (never the main account password)
EMAIL_TO=                       # Authorised recipient list (launch config: Sunil / INZBC only)
GOOGLE_SCRIPT_URL=              # Google Apps Script /exec webhook for archival sheet writes
