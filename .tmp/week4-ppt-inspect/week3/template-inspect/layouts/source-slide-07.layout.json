      "name": "Text 9",
      "bbox": [
        489.6,
        159.36,
        730.85,
        68.91
      ],
      "geometry": "rect",
      "text": "The decision repository locked the stream row with SELECT ... FOR UPDATE and re-read the head. That makes writers take turns; it does not make them disagree. The second writer read the head the first had just written and committed over it, so two contradictory decisions both landed and the loser was never told. Found by a test I wrote to fail, before release. Fixed by making the caller pass back the revision it read, so a stale decision is refused with the reason (#125).",
      "textPreview": "The decision repository locked the stream row with SELECT ... FOR UPDATE and re-read the head. That makes writers take turns; it does not...",
      "resolvedFontSize": 24,
      "resolvedTextStyle": {
        "anchor": 1,
        "fontSize": 24,
        "typeface": "Calibri",
        "color": "tx1",
        "alignment": "left",
        "verticalAlignment": "top",
        "wrap": "square",
        "insets": {
          "top": 0,
          "right": 0,
          "bottom": 0,
          "left": 0
        }
      },
      "textLayout": {
        "lineCount": 4,
        "lines": [
          {
            "index": 1,
            "text": "The decision repository locked the stream row with SELECT ... FOR UPDATE and re-read the head. That makes writers take turns; it does"
          },
          {
            "index": 2,
            "text": "not make them disagree. The second writer read the head the first had just written and committed over it, so two contradictory"
          },
          {
            "index": 3,
            "text": "decisions both landed and the loser was never told. Found by a test I wrote to fail, before release. Fixed by making the caller pass back"
          },
          {
            "index": 4,
            "text": "the revision it read, so a stale decision is refused with the reason (#125)."
          }
        ]
      },
      "paragraphs": [
