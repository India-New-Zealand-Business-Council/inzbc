{
  "_comment": [
    "PROPOSED. Not the approved policy. What counts as confidential is a business rule INZBC owns",
    "(#37), so this file is a starting point for that decision, not a substitute for it.",
    "Nothing loads it by default: REDACTION_POLICY_PATH is unset, so every model call still refuses",
    "until someone points it at an approved file. Approving it means copying it to the deployment",
    "path under a name without 'proposed' in it, and recording who approved it.",
    "",
    "Every rule carries an example it must actually redact, or the policy will not load. The",
    "examples below use example.test addresses and obviously invented numbers. Do not put real",
    "member data in this file: it is committed to the repository."
  ],
  "rules": [
    {
      "name": "email",
      "pattern": "[\\w.+-]+@[\\w-]+\\.[\\w.]{2,}",
      "replacement": "[redacted:email]",
      "example": "forward it to sunil@example.test before Friday"
    },
    {
      "name": "nz-phone",
      "pattern": "(?:\\+?64[-. ]?|\\b0)(?:2\\d|[3-9])[-. ]?\\d{3}[-. ]?\\d{3,4}\\b",
      "replacement": "[redacted:phone]",
      "example": "call the office on 09 555 0100 or 021 555 0199"
    },
    {
      "name": "india-phone",
      "pattern": "(?:\\+?91[-. ]?)[6-9]\\d{4}[-. ]?\\d{5}\\b",
      "replacement": "[redacted:phone]",
      "example": "the Mumbai contact is +91 98765 43210"
    },
    {
      "name": "nz-ird-number",
      "pattern": "\\b\\d{2,3}[- ]\\d{3}[- ]\\d{3}\\b",
      "replacement": "[redacted:ird]",
      "example": "IRD number 123-456-789 on the invoice"
    },
    {
      "name": "nzbn",
      "pattern": "\\b942\\d{10}\\b",
      "replacement": "[redacted:nzbn]",
      "example": "registered as NZBN 9429000000000"
    },
    {
      "name": "india-gstin",
      "pattern": "\\b\\d{2}[A-Z]{5}\\d{4}[A-Z][A-Z0-9]Z[A-Z0-9]\\b",
      "replacement": "[redacted:gstin]",
      "example": "GSTIN 27AAAAA0000A1Z5 on their tax invoice"
    },
    {
      "name": "india-pan",
      "pattern": "\\b[A-Z]{5}\\d{4}[A-Z]\\b",
      "replacement": "[redacted:pan]",
      "example": "PAN AAAPZ1234C was supplied"
    },
    {
      "name": "passport",
      "pattern": "(?i)\\b(?:passport|passport no\\.?|passport number)\\s*:?\\s*[A-Z]{1,2}\\d{6,8}\\b",
      "replacement": "[redacted:passport]",
      "example": "delegate passport LA123456 expires next year"
    },
    {
      "name": "payment-card",
      "pattern": "\\b(?:\\d[ -]?){13,19}\\b",
      "replacement": "[redacted:card]",
      "example": "paid on 4111 1111 1111 1111 last month"
    },
    {
      "name": "nz-bank-account",
      "pattern": "\\b\\d{2}[- ]\\d{4}[- ]\\d{7}[- ]\\d{2,3}\\b",
      "replacement": "[redacted:bank-account]",
      "example": "deposit to 01-0123-0123456-00 by the due date"
    },
    {
      "name": "member-id",
      "pattern": "(?i)\\b(?:member|membership)\\s*(?:id|no\\.?|number)\\s*:?\\s*[A-Z]{0,3}[-]?\\d{3,10}\\b",
      "replacement": "[redacted:member-id]",
      "example": "Member ID: 123456 renewed in June"
    },
    {
      "name": "street-address",
      "pattern": "\\b\\d{1,5}[A-Za-z]?\\s+(?:[A-Z][a-z]+\\s+){1,3}(?:Street|St|Road|Rd|Avenue|Ave|Drive|Dr|Lane|Ln|Terrace|Tce|Place|Pl|Crescent|Cres|Quay|Parade|Pde|Highway|Hwy)\\b",
      "replacement": "[redacted:address]",
      "example": "the office moved to 123 Queen Street last year"
    },
    {
      "name": "credential",
      "pattern": "\\b(?:sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,})",
      "replacement": "[redacted:credential]",
      "example": "the key is sk-XXXXXXXXXXXXXXXXXXXXXXXX and it works"
    },
    {
      "name": "secret-assignment",
      "pattern": "(?i)\\b(?:api[_-]?key|secret|password|passwd|token|bearer)\\b\\s*[:=]\\s*\\S+",
      "replacement": "[redacted:credential]",
      "example": "set api_key=REPLACE_ME_NOT_A_REAL_VALUE in the environment"
    }
  ]
}
