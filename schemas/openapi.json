          },
          "treatment": {
            "type": "string",
            "title": "Treatment"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "citation": {
            "type": "string",
            "title": "Citation"
          },
          "verified_at": {
            "type": "string",
            "format": "date",
            "title": "Verified At"
          },
          "status_line": {
            "type": "string",
            "title": "Status Line"
          },
          "jurisdiction": {
            "type": "string",
            "title": "Jurisdiction"
          },
          "next_step": {
            "type": "string",
            "title": "Next Step"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "confidence": {
            "type": "string",
            "title": "Confidence"
          },
          "confidence_meaning": {
            "type": "string",
            "title": "Confidence Meaning"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "topic",
          "sector",
          "treatment",
          "confirmed",
          "citation",
          "verified_at",
          "status_line",
          "jurisdiction",
          "next_step",
          "disclaimer",
          "confidence",
          "confidence_meaning"
        ],
        "title": "AnswerOut",
        "description": "A sourced FTA finding. Every field is evidence or the presentation it must carry."
      },
      "CreateRunIn": {
        "properties": {
          "run_number": {
            "type": "string",
            "title": "Run Number"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "coverage_start_utc": {
            "type": "string",
            "title": "Coverage Start Utc"
          },
          "coverage_end_utc": {
            "type": "string",
            "title": "Coverage End Utc"
          },
          "initiated_by": {
            "type": "string",
            "title": "Initiated By"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_number",
          "prompt_version",
          "coverage_start_utc",
          "coverage_end_utc",
          "initiated_by"
        ],
        "title": "CreateRunIn"
      },
      "FtaQueryResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "matched",
              "no_match"
            ],
            "title": "Status"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "answers": {
            "items": {
              "$ref": "#/components/schemas/AnswerOut"
            },
            "type": "array",
            "title": "Answers"
          },
          "action_required": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActionRequiredOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "query",
          "answers"
        ],
        "title": "FtaQueryResponse",
        "description": "`status` is the field a client branches on \u2014 not the length of `answers`.\n\nA client that only checked `answers` would render an empty results list for a no-match and\nsilently drop the escalation path, which is the outcome docs/modules/fta-centre.md exists to\nprevent."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
