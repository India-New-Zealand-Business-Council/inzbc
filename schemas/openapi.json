          "coverage_end_utc": {
            "type": "string",
            "title": "Coverage End Utc"
          },
          "initiated_by": {
            "type": "string",
            "title": "Initiated By"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "run_number",
          "state",
          "version",
          "prompt_version",
          "coverage_start_utc",
          "coverage_end_utc",
